{
  "manifest_version": 3,
  "name": "Focusa Workforce",
  "short_name": "Focusa",
  "description": "Observe, orient, create, and orchestrate your governed Focusa workforce.",
  "version": "0.9.191",
  "version_name": "0.9.184-dev",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Open Focusa Workforce"
  },
  "chrome_url_overrides": {
    "newtab": "startpage.html"
  },
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open Focusa Workforce panel"
    },
    "open-wall": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Open Focusa organization wall"
    },
    "open-workforce": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open the full Focusa Workforce page"
    }
  },
  "host_permissions": [
    "http://100.115.92.26/*",
    "http://100.115.92.26:7456/*",
    "http://100.127.113.90/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:41112/*",
    "http://localhost/*"
  ],
  "key": ""
}
